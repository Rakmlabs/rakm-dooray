{
  "name": "dooray-client",
  "version": "0.1.0",
  "private": true,
  "description": "NHN Dooray 커스텀 데스크톱 클라이언트 (메신저, 메일, 위키)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "probe": "node scripts/probe-readonly.mjs",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "kr.local.dooray-client",
    "productName": "Dooray Client",
    "files": [
      "out/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "marked": "^18.2.1",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  }
}
