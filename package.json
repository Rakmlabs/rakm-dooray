{
  "name": "dooray-client",
  "version": "0.1.1",
  "private": true,
  "description": "RAKM 두레이 — NHN Dooray 커스텀 데스크톱 클라이언트 (메신저, 위키)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "probe": "node scripts/probe-readonly.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "kr.co.rakm.dooray",
    "productName": "RAKM Dooray",
    "artifactName": "RAKM-Dooray-${version}-${arch}.${ext}",
    "copyright": "© RAKM LABS",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!node_modules/@napi-rs/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "CFBundleDisplayName": "RAKM 두레이"
      }
    },
    "dmg": {
      "sign": true,
      "title": "RAKM 두레이 ${version}"
    }
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "cfb": "^1.2.2",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "imapflow": "^2.12.2",
    "jszip": "^3.10.2",
    "mailparser": "^3.15.0",
    "marked": "^18.2.1",
    "nodemailer": "^10.6.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20",
    "ws": "^8.23.0"
  }
}
