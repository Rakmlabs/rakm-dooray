# 개발 중 실제 호출 확인용. 이 파일을 .env 로 복사해서 채운다. .env 는 커밋되지 않는다.
# 앱은 설정 화면에 저장된 값(OS 키체인 암호화)을 우선 쓰고, 개발 모드에서 설정이 비어 있을 때만 .env 를 읽는다.
DOORAY_TOKEN=
# 민간 클라우드 기본값. 공공: https://api.gov-dooray.com / 금융: https://api.dooray.co.kr
DOORAY_API_BASE=https://api.dooray.com
# Socket Mode 시도용 회사 도메인 (예: mycompany.dooray.com). 비우면 폴링만 한다.
DOORAY_DOMAIN=

MAIL_ADDRESS=
# 두레이 설정 > 메일 > IMAP 화면의 비밀번호
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.dooray.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.dooray.com
MAIL_SMTP_PORT=465
